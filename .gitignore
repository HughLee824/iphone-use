# Build products and tool caches
/.build/
/packages/runner-support/.build/
/packages/runner-support/.swiftpm/
/.swiftpm/
/build/
/DerivedData/
*.xcresult/
*.xcarchive/
*.dSYM/
*.ipa
__pycache__/
*.py[cod]

# Legacy output paths remain ignored; archives now live under .local/output/.
# Final brand assets live in assets/brand.
/output/
/assets/brand/archive/
/assets/brand/iphone-use-final/*.png
/assets/brand/iphone-use-final/validation.json

# Machine-specific settings and diagnostics
.DS_Store
xcuserdata/
*.xcuserstate
*.log

# Local signing credentials and environment configuration
*.mobileprovision
*.provisionprofile
*.p12
*.pfx
*.p8
.env
.env.*
!.env.example
!.env.*.example

# Local development notes, experiments, device evidence, and archived output/spikes
/.local/
# Keep the former experiment path ignored if an old tool recreates it.
/spikes/
/alignment.md
/design-qa.md

# Optional personal skill installation; keep tracked marketplace configuration visible.
/.agents/skills/huashu-motion/
/skills-lock.json

# Public documentation lives in docs/; private notes and captures belong in .local/.
